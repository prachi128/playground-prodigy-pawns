DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=generate-a-long-random-secret-at-least-32-chars

# development | staging | production
ENVIRONMENT=development

# Optional override for Secure cookies (defaults: secure in staging/production or when FRONTEND_URL is https)
# COOKIE_SECURE=true

# Primary frontend origin (also added to CORS allowlist)
FRONTEND_URL=http://localhost:3000

# Extra CORS origins (comma-separated). Required in staging/production if FRONTEND_URL is unset.
# Example production:
# CORS_ORIGINS=https://app.toruschess.com
# CORS_ORIGINS=

# Required for password reset + coach invite emails
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_your_resend_api_key
# Optional alias for coach invites (Resend HTTP API). Falls back to SMTP_PASSWORD.
# RESEND_API_KEY=re_your_resend_api_key
SMTP_FROM="Torus Chess <noreply@toruschess.com>"
SMTP_USE_TLS=true
# Local dev without a verified domain: use Resend's test sender and invite only your
# Resend account email, e.g. SMTP_FROM="Torus Chess <onboarding@resend.dev>"
